# Supabase configuration
# Copy this file to ".env" and fill in your project values.
#
# IMPORTANT:
#  - Only use the ANON / PUBLISHABLE key in the client app.
#  - NEVER put the service_role key in the frontend or commit it anywhere.
#  - Variables must be prefixed with EXPO_PUBLIC_ to be available in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
